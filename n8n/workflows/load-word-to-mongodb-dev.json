    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst parsed = JSON.parse(raw);\n\n// parsed.Result is an array → map it into n8n items\nreturn parsed.Result.map(r => ({\n  json: {\n    WordId: r.WordId,\n    Word: r.Word,\n    Description: r.Meaning\n  }\n}));\n"
      },
