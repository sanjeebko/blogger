        "ollamaApi": {
          "id": "zyl6PeV6maQJ0cH2",
          "name": "Ollama account"
        }
      },
      "notes": "You are the export to identify best meaning of a word from a list of words provided."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "From the list of words and it's descriptions. Give me the meaning of the word in the json format {\"word\":\"word\", \"meaning\":\"meaning of the word\"}. The json should contain a single result. ",
        "hasOutputParser": true,
        "options": {
