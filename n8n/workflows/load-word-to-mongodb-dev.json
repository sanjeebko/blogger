      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": ";WITH FirstUnprocessed AS (\n    SELECT TOP 1 Word\n    FROM GameDictionaryCopy\n    WHERE Processed = 0\n    ORDER BY WordId\n)\nSELECT \n    g.WordId,\n    g.Word,\n    g.Description,\n    g.Processed\nFROM GameDictionaryCopy g\nINNER JOIN FirstUnprocessed f\n    ON g.Word = f.Word\nORDER BY g.WordId;\n"
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [224, 0],
      "id": "657b99a5-0ae0-47e8-a71c-0f5d7e93470c",
      "name": "Microsoft SQL",
      "credentials": {
        "microsoftSql": {
          "id": "kLWBEttuiVOg5QUX",
          "name": "Microsoft SQL account"
        }
      }
    },
    {
      "parameters": {
        "operation": "toJson",
        "options": {
          "format": true,
          "fileName": "={{ $json.Word }}"
        }
      },
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [448, 0],
      "id": "4b483f6e-8e0a-4c1b-8628-5bfa7f7c3e03",
      "name": "Convert to File",
